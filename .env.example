# PostgreSQL / Railway
DATABASE_URL=postgresql+psycopg://user:password@host:5432/newsletter

# Gmail OAuth. Generate GOOGLE_REFRESH_TOKEN with: newsletter-agent auth
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_REFRESH_TOKEN=replace-me

# OpenAI-compatible chat completion endpoint
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=replace-me
LLM_MODEL=replace-me

# OpenAI-compatible embeddings base endpoint.
# OpenRouter example: https://openrouter.ai/api/v1
EMBEDDING_BASE_URL=https://api.example.com/v1
EMBEDDING_API_KEY=replace-me
EMBEDDING_MODEL=replace-me
EMBEDDING_DIMENSIONS=768

# Optional
NEWSLETTER_CONFIG=config.yaml
LOG_LEVEL=INFO
